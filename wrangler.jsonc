{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "04947b996d85ee530922a8af9707229b",
	"name": "weeding-invitation",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker/index.ts",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "save-the-date-nam-v11-db",
			"database_id": "5280b93c-1d0b-47e3-87cc-3035eedae028"
		}
	]
}